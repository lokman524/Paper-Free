# Appwrite Configuration
# Copy this file to .env and replace these placeholder values with your actual Appwrite project details

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_APPWRITE_PLATFORM=com.yourcompany.paperfree
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
EXPO_PUBLIC_APPWRITE_USER_COLLECTION_ID=your_user_collection_id_here
